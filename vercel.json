{
  "redirects": [
    {
      "source": "/rlc",
      "destination": "/rlc/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/maxlab/:slug",
      "destination": "/api/maxlab/render?slug=:slug"
    },
    {
      "source": "/maxlab/:slug/",
      "destination": "/api/maxlab/render?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/penawaran/rlc/index.html"
    },
    {
      "source": "/penawaran/rlc/bab/:slug/",
      "destination": "/penawaran/rlc/index.html"
    },
    {
      "source": "/penawaran/rlc/bab/:slug",
      "destination": "/penawaran/rlc/index.html"
    },
    {
      "source": "/live",
      "destination": "/rlc/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/test/index.html?slug=:slug"
    }
  ]
}
